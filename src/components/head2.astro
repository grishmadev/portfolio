---
const details = [
  'delivery-rate',
  'hello-len',
  'quic',
  'rtt',
  'transfer',
  'ttfb',
  'started',
];
---

<div class="w-full flex bg-(--primary-blue) p-1 justify-between font-[jetbrains_mono] text-xs font-bold">
  <div></div>
  <div class="flex gap-1">
    {details.map((t) => (
      <>
        <span>[</span>
        <span id={t}></span>
        <span>]</span>
      </>
    ))}
  </div>
</div>
