---
import Block from "@components/block.astro";
import Arsenal from "@components/arsenal.astro"
import GitHub from "@components/github.astro"
const skills = ["Typescript", "NodeJS", "GitHub", "Rust", "C++", "Python", "Docker"];
---

<div class="flex flex-wrap gap-3 p-4 justify-center">
  <!-- image -->
  <div class="max-w-220 w-full flex-1 min-w-120">
    <img src="/polar_bear2.webp" class="rounded w-full object-cover h-full" />
  </div>

  <!-- info -->
  <div class="max-w-220 min-w-120 w-full gap-2 flex flex-col flex-1">
    <div class="p-3 rounded bg-(--primary-blue) w-full flex items-center align-center gap-3 text-2xl">
      <img
        src="https://github.com/grishmadev.png"
        alt="Grishma avatar"
        class="h-10 w-10 shrink-0 rounded object-cover"
      />
      <span class="leading-none">
        Grishma's Appraisal //
      </span>
      <span class="hidden lg:inline">[ 評估 ]</span>
    </div>
    <div class="font-[jetbrains_mono] grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-2">
      <Block head="Base" info="India" />
      <Block field="education" head="Education" info="B. Sc. Mathematics" />
      <Block head="Primary Domain" info="Backend Engineering" />
      <Block head="Interests" info="Systems & Network" />
    </div>
    <Arsenal skills={skills} />
    <GitHub />
  </div>
</div>
<script>
  const uniStart = { month: 8, year: 2026 };
  const now = new Date();
  const yearsElapsed =
    now.getFullYear() - uniStart.year + (now.getMonth() - uniStart.month) / 12;
  const yearNum = Math.max(1, Math.floor(yearsElapsed) + 1);
  const el = document.querySelector<HTMLSpanElement>(`#education`);
  if (el)
    el.textContent = `B. Sc. Mathematics (${yearNum <= 6 ? `Year ${yearNum}` : "Completed."})`;
</script>
